# Copy this file to .env and fill in the values. NEVER commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Optional: PostgreSQL in production (SQLite is used when this is empty/absent)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email (password reset). The console backend prints emails in the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=StaffConnect <noreply@novatech.example>
